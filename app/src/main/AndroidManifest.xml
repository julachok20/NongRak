<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      Coarse only, and optional: it finds child-friendly places near the family for the activity
      schedule's suggestions. Declining it costs the place suggestions, nothing else in the app.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Health Connect read permissions (Google Fit / Samsung / Fitbit / Garmin bridge) -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />

    <!-- Camera is optional so the app still installs on devices/emulators without one -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Make the speech recognizer visible (Android 11+) for the chatbot mic. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Make the text-to-speech engine visible (Android 11+) so the AI can read replies aloud. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
        <!-- Make calendar apps visible (Android 11+) for the "add vaccine to calendar" button —
             without this, ACTION_INSERT on the calendar Events URI can fail to resolve even when
             a calendar app is installed. -->
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.item/event" />
        </intent>
    </queries>

    <application
        android:name=".NongRakApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NongRak"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Bundles ML Kit barcode model in APK — avoids runtime download crash on first scan. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.NongRak.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Supabase OAuth deep link -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="${supabaseRedirectScheme}"
                    android:host="auth" />
            </intent-filter>

            <!-- Health Connect permission rationale (required by HC policy) -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>

        <!-- Declares Health Connect privacy policy link for the permissions screen -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Home-screen widget: last feeding/sleep at a glance, tap to open the app -->
        <receiver
            android:name=".widget.DailyOverviewWidgetReceiver"
            android:exported="false"
            android:label="@string/daily_overview_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_overview_widget_info" />
        </receiver>

        <!-- Home-screen widget: latest weight/height with trend, tap to open the app -->
        <receiver
            android:name=".widget.GrowthTrackerWidgetReceiver"
            android:exported="false"
            android:label="@string/growth_tracker_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/growth_tracker_widget_info" />
        </receiver>

        <!-- Home-screen widget: nearest upcoming vaccine, tap to open the app -->
        <receiver
            android:name=".widget.VaccineReminderWidgetReceiver"
            android:exported="false"
            android:label="@string/vaccine_reminder_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vaccine_reminder_widget_info" />
        </receiver>

        <!-- Home-screen widget: development milestone progress, tap to open the app -->
        <receiver
            android:name=".widget.MilestoneWidgetReceiver"
            android:exported="false"
            android:label="@string/milestone_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/milestone_widget_info" />
        </receiver>

        <!-- Home-screen widget: latest sleep session duration, tap to open the app -->
        <receiver
            android:name=".widget.SleepAnalyticsWidgetReceiver"
            android:exported="false"
            android:label="@string/sleep_analytics_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sleep_analytics_widget_info" />
        </receiver>

        <!-- Home-screen widget: today's medicine doses with a one-tap "taken" action -->
        <receiver
            android:name=".widget.MedicineDoseWidgetReceiver"
            android:exported="false"
            android:label="@string/medicine_dose_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/medicine_dose_widget_info" />
        </receiver>

        <!-- Home-screen widget: quick-log shortcut row, tap to open the app -->
        <receiver
            android:name=".widget.QuickActionHubWidgetReceiver"
            android:exported="false"
            android:label="@string/quick_action_hub_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_action_hub_widget_info" />
        </receiver>

        <!-- Shares generated PDF reports (doctor export) via a content:// URI -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
