<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NongRak" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.NongRak.Splash" parent="Theme.SplashScreen">
